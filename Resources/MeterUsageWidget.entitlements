<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit extensions must be sandboxed; the system refuses to load
	     or even register an unsandboxed widget provider (verified
	     2026-08-24: an entitlement-free appex never appears in pluginkit). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The snapshot file lives in this group container, which the sandbox
	     explicitly allows. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.meterusage.app</string>
	</array>
</dict>
</plist>
